    <script>
        // REPLACE WITH YOUR DEPLOYED GOOGLE APPS SCRIPT WEB APP URL
        const APPS_SCRIPT_URL = "YOUR_GOOGLE_APPS_SCRIPT_WEB_APP_URL_HERE";

        function openModal() { document.getElementById('callModal').style.display = 'flex'; }
        function closeModal() { document.getElementById('callModal').style.display = 'none'; }

        async function submitCall() {
            const payload = {
                date: document.getElementById('callDate').value,
                msisdn: document.getElementById('callMsisdn').value,
                avaya: document.getElementById('callAvaya').value,
                csa: document.getElementById('callCsa').value,
                sup: document.getElementById('callSup').value,
                type: document.getElementById('callType').value
            };

            if(!payload.msisdn || !payload.avaya) {
                alert("Please fill in MSISDN and AVAYA ID.");
                return;
            }

            try {
                const response = await fetch(APPS_SCRIPT_URL, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                alert("Call successfully logged and sent to Google Sheet!");
                closeModal();
                location.reload();
            } catch (err) {
                alert("Error sending to sheet: " + err);
            }
        }

        // Charts Init
        Chart.defaults.color = '#94a3b8';
        Chart.defaults.borderColor = 'rgba(255, 255, 255, 0.05)';
        
        new Chart(document.getElementById('trendChart').getContext('2d'), {
            type: 'bar',
            data: {
                labels: ['Nov 1', 'Nov 2', 'Nov 3', 'Nov 4', 'Nov 5', 'Nov 6'],
                datasets: [{ data: [13, 0, 0, 0, 0, 6], backgroundColor: '#00f2fe', borderRadius: 6 }]
            },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
        });

        new Chart(document.getElementById('supPieChart').getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: ['Sattazit Gosh', 'Sanjida Tinny', 'Imam Hossain'],
                datasets: [{ data: [6, 4, 3], backgroundColor: ['#00f2fe', '#8b5cf6', '#3b82f6'], borderWidth: 0 }]
            },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
        });
    </script>
